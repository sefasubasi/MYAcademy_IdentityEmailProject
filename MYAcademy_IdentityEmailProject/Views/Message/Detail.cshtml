@model MYAcademy_IdentityEmailProject.Entities.Message

<style>

    .mail-detail {
        color: #34364f;
        width: 100%;
    }

    .mail-detail-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 24px;
    }

    .mail-detail-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 15px;
        background: #eeeaff;
        color: #8069d8;
        font-size: 22px;
    }

    .mail-detail-title {
        min-width: 0;
    }

    .mail-detail-label {
        color: #9384cb;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.3px;
    }

    .mail-detail-title h3 {
        font-size: 21px;
        font-weight: 700;
        margin: 4px 0 0;
        overflow-wrap: anywhere;
    }

    .mail-detail-info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        padding: 18px;
        background: #f8f7fd;
        border: 1px solid #eeebf8;
        border-radius: 15px;
    }

    .mail-info-item {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .mail-info-icon {
        width: 38px;
        height: 38px;
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        background: #ece8ff;
        color: #8069d8;
        border-radius: 11px;
        font-size: 16px;
    }

    .mail-info-item small {
        display: block;
        color: #9293a6;
        font-size: 11px;
        margin-bottom: 3px;
    }

    .mail-info-item strong {
        display: block;
        font-size: 12px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .mail-detail-content {
        margin-top: 20px;
        padding: 20px;
        border: 1px solid #eeebf8;
        border-radius: 15px;
        background: #fff;
    }

    .mail-content-heading {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #8069d8;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 13px;
    }

    .mail-content-text {
        color: #55566b;
        font-size: 14px;
        line-height: 1.8;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .mail-detail-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 16px;
        color: #a1a0b2;
        font-size: 11px;
    }

    @@media (max-width: 576px) {
        .mail-detail-info {
            grid-template-columns: 1fr;
            padding: 14px;
        }

        .mail-detail-title h3 {
            font-size: 17px;
        }

        .mail-detail-content {
            padding: 15px;
        }
    }

</style>

<div class="mail-detail">

    <div class="mail-detail-heading">
        <div class="mail-detail-icon">
            <i class="bi bi-envelope-open"></i>
        </div>

        <div class="mail-detail-title">
            <span class="mail-detail-label">MESAJ DETAYI</span>
            <h3>@Model.Subject</h3>
        </div>
    </div>

    <div class="mail-detail-info">
        <div class="mail-info-item">
            <div class="mail-info-icon">
                <i class="bi bi-person"></i>
            </div>
            <div>
                <small>Gönderen</small>
                <strong>@Model.SenderEmail</strong>
            </div>
        </div>

        <div class="mail-info-item">
            <div class="mail-info-icon">
                <i class="bi bi-person-check"></i>
            </div>
            <div>
                <small>Alıcı</small>
                <strong>@Model.ReceiverEmail</strong>
            </div>
        </div>

        <div class="mail-info-item">
            <div class="mail-info-icon">
                <i class="bi bi-calendar3"></i>
            </div>
            <div>
                <small>Gönderim Tarihi</small>
                <strong>@Model.SendDate.ToString("dd MMMM yyyy, HH:mm")</strong>
            </div>
        </div>
    </div>

    <div class="mail-detail-content">
        <div class="mail-content-heading">
            <i class="bi bi-chat-left-text"></i>
            <span>Mesaj İçeriği</span>
        </div>

        <div class="mail-content-text">
            @Model.MessageDetail
        </div>
    </div>

    <div class="mail-detail-footer">
        <span>
            <i class="bi bi-shield-check"></i>
            Mailora Mesaj Sistemi
        </span>
    </div>

</div>

