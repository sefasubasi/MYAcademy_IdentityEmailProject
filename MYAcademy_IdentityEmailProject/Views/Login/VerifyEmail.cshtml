@model UserLoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "E-posta Doğrulama";
}



<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mailora | E-posta Doğrulama</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
            :root {
                --primary: #6366f1;
                --primary-light: #eef2ff;
                --text-dark: #252641;
                --text-muted: #85879a;
                --border: #e8e9f2;
                --background: #f6f7fc;
            }

            * {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                margin: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 30px 15px;
                background: var(--background);
                font-family: 'Segoe UI', sans-serif;
                color: var(--text-dark);
            }

            .verify-wrapper {
                width: 100%;
                max-width: 490px;
            }

            .brand {
                text-align: center;
                margin-bottom: 25px;
            }

            .brand-icon {
                width: 54px;
                height: 54px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: var(--primary-light);
                color: var(--primary);
                border-radius: 17px;
                font-size: 25px;
                margin-bottom: 10px;
            }

            .brand h2 {
                font-weight: 750;
                letter-spacing: -1px;
                margin: 0;
            }

            .brand span {
                color: var(--primary);
            }

            .verify-card {
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 22px;
                padding: 35px;
                box-shadow: 0 12px 45px rgba(35, 39, 80, .06);
            }

            .mail-icon {
                width: 66px;
                height: 66px;
                margin: 0 auto 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 20px;
                background: var(--primary-light);
                color: var(--primary);
                font-size: 29px;
            }

            .verify-title {
                font-size: 25px;
                font-weight: 750;
                text-align: center;
                margin-bottom: 9px;
            }

            .verify-description {
                color: var(--text-muted);
                font-size: 14px;
                text-align: center;
                line-height: 1.6;
                margin-bottom: 25px;
            }

            .user-info {
                background: #f8f9ff;
                border: 1px solid var(--border);
                border-radius: 14px;
                padding: 17px;
                margin-bottom: 25px;
            }

            .info-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 8px 0;
                font-size: 13px;
            }

            .info-row:not(:last-child) {
                border-bottom: 1px solid #ebecf5;
            }

            .info-label {
                color: var(--text-muted);
            }

            .info-value {
                font-weight: 600;
                text-align: right;
                overflow-wrap: anywhere;
            }

            .form-label {
                font-size: 13px;
                font-weight: 650;
                margin-bottom: 10px;
            }

            .code-input {
                height: 57px;
                border: 1px solid var(--border);
                border-radius: 12px;
                font-size: 22px;
                font-weight: 700;
                letter-spacing: 10px;
                text-align: center;
            }

            .code-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(99, 102, 241, .10);
            }

            .btn-verify {
                height: 50px;
                background: var(--primary);
                border: none;
                border-radius: 12px;
                color: #fff;
                font-weight: 650;
                transition: .2s;
            }

            .btn-verify:hover {
                background: #5153d8;
                color: #fff;
                transform: translateY(-1px);
            }

            .resend-area {
                text-align: center;
                margin-top: 22px;
                font-size: 13px;
                color: var(--text-muted);
            }

            .resend-area button {
                border: none;
                background: transparent;
                color: var(--primary);
                font-weight: 700;
                padding: 0;
            }

            .back-link {
                display: block;
                text-align: center;
                margin-top: 23px;
                text-decoration: none;
                color: var(--text-muted);
                font-size: 13px;
            }

            .back-link:hover {
                color: var(--primary);
            }

            .validation-message {
                color: #dc3545;
                font-size: 13px;
                margin-top: 8px;
            }

            @@media (max-width: 480px) {
                .verify-card {
                    padding: 25px 20px;
                }

                .verify-title {
                    font-size: 22px;
                }
            }
    </style>
</head>
<body>

    <div class="verify-wrapper">

        <div class="brand">
            <div class="brand-icon">
                <i class="bi bi-envelope-paper-heart"></i>
            </div>
            <h2>mail<span>ora</span></h2>
        </div>

        <div class="verify-card">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <div class="mail-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <h1 class="verify-title">E-posta adresini doğrula</h1>

            <p class="verify-description">
                Hesabını güvenli hale getirmek için e-posta adresine
                gönderdiğimiz 6 haneli doğrulama kodunu gir.
            </p>

            <!-- Kullanıcı bilgileri -->
            <div class="user-info">

                <div class="info-row">
                    <span class="info-label">Ad Soyad</span>
                    <span class="info-value">@Model.Name @Model.Surname</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Kullanıcı Adı</span>
                    <span class="info-value">@Model.Username</span>
                </div>

                <div class="info-row">
                    <span class="info-label">E-posta</span>
                    <span class="info-value">@Model.Email</span>
                </div>

            </div>

            <!-- Kod doğrulama formu -->
            <form asp-controller="Login" asp-action="VerifyEmail" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Email" />

                <div class="mb-3">
                    <label asp-for="Code" class="form-label">
                        Doğrulama Kodu
                    </label>

                    <input asp-for="Code"
                           class="form-control code-input"
                           maxlength="6"
                           inputmode="numeric"
                           placeholder="000000" />

                    <span asp-validation-for="Code"
                          class="validation-message"></span>

                    <div class="text-center mt-3">
                        <span class="text-muted">Kodun geçerlilik süresi:</span>
                        <span id="countdown"
                              class="fw-bold text-primary"
                              data-expiration="@ViewBag.CodeExpiration">
                            01:00
                        </span>
                    </div>

                    <div id="expiredMessage"
                         class="alert alert-warning text-center mt-3"
                         style="display:none;">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Doğrulama kodunun süresi doldu. Devam etmek için yeni bir kod oluşturun.
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly"
                     class="validation-message mb-3"></div>

                <button type="submit" class="btn btn-verify w-100">
                    <i class="bi bi-check-circle me-2"></i>
                    Kodu Doğrula
                </button>

            </form>

            <!-- Yeni kod gönderme -->
            <div class="resend-area">
                Kod eline ulaşmadı mı?

                <form asp-controller="Login"
                      asp-action="GenerateNewCode"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

@*                     <input type="hidden" name="email" value="@Model.Email" />
 *@
                    <button type="submit">Yeni kod gönder</button>
                </form>
            </div>

            <a asp-controller="Login"
               asp-action="SignIn"
               class="back-link">
                <i class="bi bi-arrow-left me-1"></i>
                Giriş sayfasına dön
            </a>

        </div>

        <p class="text-center mt-4"
           style="font-size:12px;color:#a0a1b1;">
            © 2026 Mailora. Tüm hakları saklıdır.
        </p>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            const countdownElement = document.getElementById("countdown");

            const expirationDate = new Date(
                countdownElement.dataset.expiration
            ).getTime();

            function updateCountdown() {

                const remainingTime = expirationDate - Date.now();

                if (remainingTime <= 0) {
                    countdownElement.innerText = "00:00";

                    expiredMessage.style.display = "block";
                    codeInput.disabled = true;
                    verifyButton.disabled = true;

                    return;
                }

                const minutes = Math.floor(remainingTime / 60000);
                const seconds = Math.floor((remainingTime % 60000) / 1000);

                countdownElement.innerText =
                    String(minutes).padStart(2, "0") + ":" +
                    String(seconds).padStart(2, "0");
            }

            updateCountdown();

            setInterval(updateCountdown, 1000);
    </script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>

